# ─────────────────────────────────────────────────────────────────────────────
# Smart Résumé Screener — Environment Variables
# Copy this file to .env (cp .env.example .env) and adjust if needed
# ─────────────────────────────────────────────────────────────────────────────

# Local models via Ollama (https://ollama.com)
# Pull them first:  ollama pull llama3.2:1b   and   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ENABLE_AI_EXPLANATIONS=false

# Not used when running on Ollama. Leave empty.
OPENAI_API_KEY=

# Server settings (use 0.0.0.0 only inside Docker or to allow other devices)
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Cache settings (local disk cache for embeddings)
CACHE_DIR=.cache/embeddings
CACHE_TTL_SECONDS=86400

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_RESUMES_PER_BATCH=20

# Scoring weights (must sum to 1.0)
WEIGHT_EMBEDDING=0.50
WEIGHT_KEYWORD=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_BONUS=0.05

# Optional (JSON list): allowed browser origins
# CORS_ORIGINS=["http://localhost:8000","http://localhost:5173"]